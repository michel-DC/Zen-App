<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Zen.WinUI</RootNamespace>
    <AssemblyName>Zen</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationIcon>Assets\Zen.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="App.xaml.cs" />
    <Compile Include="MainWindow.xaml.cs" />
    <Compile Include="DocxLayoutRestorer.cs" />
    <Compile Include="FileProcessor.cs" />
    <Compile Include="ImageProcessor.cs" />
    <Compile Include="OcrProcessor.cs" />
    <Compile Include="OfficeDocumentProcessor.cs" />
    <Compile Include="PdfTextProcessor.cs" />
    <Compile Include="PdfToDocxConverter.cs" />
    <Compile Include="DocxPageRestorer.cs" />
    <Compile Include="DocxParallelSectionRestorer.cs" />
    <Compile Include="TemporaryFontLoader.cs" />
    <Compile Include="TextExtractionService.cs" />
    <Compile Include="ToolCatalog.cs" />
    <Compile Include="WordImportWarningHelper.cs" />
    <Compile Include="WordToPdfConverter.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\Zen.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\Zen.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\Fonts\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="tessdata\*.traineddata">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="CopyWinUiMarkupToPublishDirectory" AfterTargets="Publish">
    <ItemGroup>
      <WinUiMarkup Include="$(OutputPath)App.xbf" />
      <WinUiMarkup Include="$(OutputPath)MainWindow.xbf" />
      <WinUiMarkup Include="$(OutputPath)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy SourceFiles="@(WinUiMarkup)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
