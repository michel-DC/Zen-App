<Window
    x:Class="Zen.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    Title="Zen">
    <Window.SystemBackdrop>
        <media:MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <controls:NavigationView
            x:Name="Navigation"
            PaneTitle="Zen"
            PaneDisplayMode="Auto"
            IsPaneOpen="True"
            OpenPaneLength="288"
            CompactPaneLength="48"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            HorizontalContentAlignment="Stretch"
            SelectionChanged="Navigation_SelectionChanged">
            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItemHeader Content="Convertir" />
                <controls:NavigationViewItem x:Name="DocxPdfItem" Content="DOCX en PDF" Tag="docx_pdf"><controls:NavigationViewItem.Icon><SymbolIcon Symbol="Document" /></controls:NavigationViewItem.Icon></controls:NavigationViewItem>
                <controls:NavigationViewItem Content="PDF en DOCX" Tag="pdf_docx"><controls:NavigationViewItem.Icon><SymbolIcon Symbol="Document" /></controls:NavigationViewItem.Icon></controls:NavigationViewItem>
                <controls:NavigationViewItem Content="Image en JPG" Tag="image_jpg"><controls:NavigationViewItem.Icon><SymbolIcon Symbol="Pictures" /></controls:NavigationViewItem.Icon></controls:NavigationViewItem>
                <controls:NavigationViewItem Content="PNG en PDF" Tag="png_pdf"><controls:NavigationViewItem.Icon><SymbolIcon Symbol="Pictures" /></controls:NavigationViewItem.Icon></controls:NavigationViewItem>
                <controls:NavigationViewItem Content="JPG en PDF" Tag="jpg_pdf"><controls:NavigationViewItem.Icon><SymbolIcon Symbol="Pictures" /></controls:NavigationViewItem.Icon></controls:NavigationViewItem>
                <controls:NavigationViewItemHeader Content="Extraire" />
                <controls:NavigationViewItem Content="Texte d’un PDF" Tag="pdf_text"><controls:NavigationViewItem.Icon><SymbolIcon Symbol="Find" /></controls:NavigationViewItem.Icon></controls:NavigationViewItem>
                <controls:NavigationViewItem Content="Texte d’un DOCX" Tag="docx_text"><controls:NavigationViewItem.Icon><SymbolIcon Symbol="Find" /></controls:NavigationViewItem.Icon></controls:NavigationViewItem>
                <controls:NavigationViewItem Content="Texte d’une image" Tag="image_ocr"><controls:NavigationViewItem.Icon><SymbolIcon Symbol="Find" /></controls:NavigationViewItem.Icon></controls:NavigationViewItem>
                <controls:NavigationViewItemHeader Content="Image" />
                <controls:NavigationViewItem Content="Rogner une image" Tag="crop"><controls:NavigationViewItem.Icon><SymbolIcon Symbol="Crop" /></controls:NavigationViewItem.Icon></controls:NavigationViewItem>
                <controls:NavigationViewItem Content="Arrondir les coins" Tag="rounded"><controls:NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></controls:NavigationViewItem.Icon></controls:NavigationViewItem>
                <controls:NavigationViewItem Content="Créer une image circulaire" Tag="circle"><controls:NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></controls:NavigationViewItem.Icon></controls:NavigationViewItem>
            </controls:NavigationView.MenuItems>

            <Grid Padding="32,28,32,24" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <controls:InfoBar x:Name="StatusInfo" Grid.Row="0" IsOpen="False" IsClosable="True" />

                <StackPanel Grid.Row="1" Spacing="8">
                    <TextBlock x:Name="PageTitle" Style="{ThemeResource TitleLargeTextBlockStyle}" />
                    <TextBlock x:Name="PageDescription" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Grid ColumnSpacing="20" Padding="0,4,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
                            <StackPanel Spacing="20">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Fichiers" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Name="FilesDescription" Text="Sélectionnez la source puis confirmez l’emplacement du résultat." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="144" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBox x:Name="SourcePath" Header="Fichier source" MinHeight="40" PlaceholderText="Choisissez ou collez le chemin du fichier" TextChanged="SourcePath_TextChanged" />
                                    <Button x:Name="BrowseInputButton" AutomationProperties.AutomationId="BrowseInputButton" Grid.Column="1" Content="Parcourir" MinHeight="40" Click="ChooseInput_Click" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" />
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Parcourez vos fichiers ou collez un chemin. Rien n’est envoyé sur Internet." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
                                </Grid>

                                <Border x:Name="OutputDivider" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <Grid x:Name="OutputSection" ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="144" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBox x:Name="OutputPath" Header="Fichier de sortie" IsReadOnly="True" MinHeight="40" PlaceholderText="Même dossier que le fichier source" />
                                    <Button x:Name="BrowseOutputButton" AutomationProperties.AutomationId="BrowseOutputButton" Grid.Column="1" Content="Enregistrer sous" MinHeight="40" Click="ChooseOutput_Click" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" />
                                    <TextBlock x:Name="OutputHint" Grid.Row="1" Grid.ColumnSpan="2" Text="Zen proposera un fichier dans le dossier source." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
                                </Grid>

                                <Grid x:Name="ExtractedTextSection" RowSpacing="12" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Texte extrait" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="Le résultat reste dans Zen jusqu’au prochain traitement." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                        <Button x:Name="CopyTextButton" AutomationProperties.AutomationId="CopyTextButton" Grid.Column="1" Content="Copier tout" MinHeight="40" IsEnabled="False" Click="CopyText_Click" />
                                    </Grid>
                                    <TextBox x:Name="ExtractedTextBox" AutomationProperties.AutomationId="ExtractedTextBox" Grid.Row="1" MinHeight="260" MaxHeight="420" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" PlaceholderText="Le texte extrait apparaîtra ici." />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Column="1" RowSpacing="0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

                            <Border x:Name="OptionsCard" Grid.Row="0" Margin="0,0,0,16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Visibility="Collapsed">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Options" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <Grid x:Name="CropOptions" ColumnSpacing="12" RowSpacing="12" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <NumberBox x:Name="CropX" Header="X" Minimum="0" Value="0" SpinButtonPlacementMode="Inline" />
                                        <NumberBox x:Name="CropY" Grid.Column="1" Header="Y" Minimum="0" Value="0" SpinButtonPlacementMode="Inline" />
                                        <NumberBox x:Name="CropWidth" Grid.Row="1" Header="Largeur" Minimum="1" Value="800" SpinButtonPlacementMode="Inline" />
                                        <NumberBox x:Name="CropHeight" Grid.Row="1" Grid.Column="1" Header="Hauteur" Minimum="1" Value="800" SpinButtonPlacementMode="Inline" />
                                    </Grid>
                                    <StackPanel x:Name="RadiusOptions" Spacing="8" Visibility="Collapsed">
                                        <NumberBox x:Name="Radius" Header="Rayon des coins" Minimum="1" Maximum="300" Value="48" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
                                <Grid RowSpacing="20">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Résumé" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        <TextBlock Text="Vérifiez l’opération avant de lancer le traitement." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="État" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Name="ResultLabel" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="Le traitement s’effectue uniquement sur cet ordinateur." TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ProgressRing x:Name="Progress" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                                            <TextBlock Text="Prêt pour une opération locale" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                        <Button x:Name="RunButton" MinHeight="44" Content="Convertir en PDF" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Style="{StaticResource AccentButtonStyle}" Click="Run_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </controls:NavigationView>
    </Grid>
</Window>
